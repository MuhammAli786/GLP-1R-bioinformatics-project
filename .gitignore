# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# R
.Rhistory
.RData
.Rproj.user/

# Raw GEO inputs (excluded by design — re-download from GEO by accession)
*.tar
*.mtx
*_RAW/
raw/
*.txt.gz
*.tsv.gz
*_supplementary/
# Serialized R objects (ExpressionSets, DESeq2 dds, enrichment result objects).
# Excluded by design: ~313 MB across the HIBI arm, and regenerable by re-running
# the stage scripts. Their derived CSV/TXT tables ARE tracked.
*.rds
*.RDS
# Large compressed matrices, should they ever be added
*.bam
*.bam.gz

# Written analysis reports / interpretation write-ups — kept locally, not in the
# repository.
reports/
*.docx
*.doc
*.odt
